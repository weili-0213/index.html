=================================

Baccarat Rules Engine

負責：

- 點數計算
- 補牌規則
- 勝負判定

=================================
*/


export default class BaccaratRules {



    /*
    單張牌點數

    A=1
    2~9=牌面
    10/J/Q/K=0

    */


    static cardValue(card){


        if(card === "A"){

            return 1;

        }


        if(
            [
                "10",
                "J",
                "Q",
                "K"
            ]
            .includes(card)
        ){

            return 0;

        }


        return Number(card);


    }





    /*
    計算手牌點數

    百家樂只看個位數

    例如：

    7+8=15

    =>5


    */


    static handValue(cards){


        let total = 0;


        cards.forEach(card=>{


            total +=
            this.cardValue(card);


        });


        return total % 10;


    }





    /*
    判斷天牌

    前兩張：

    8或9

    */


    static isNatural(player, banker){


        const p =
        this.handValue(player);


        const b =
        this.handValue(banker);



        return (

            player.length === 2 &&

            banker.length === 2 &&

            (
                p >= 8 ||
                b >= 8
            )

        );


    }







    /*
    Player 是否補牌


    規則：

    0~5 補

    6~7 停牌


    */


    static playerDraw(player){


        const value =
        this.handValue(player);


        return value <= 5;


    }







    /*
    Banker 補牌

    兩張牌時：

    Banker：

    0-2 必補
    3-6 視 Player 第三張
    7 停


    */


    static bankerDraw(
        banker,
        playerThirdCard = null
    ){


        const bankerValue =
        this.handValue(banker);



        /*
        0-2

        必補

        */


        if(
            bankerValue <= 2
        ){

            return true;

        }




        /*
        7

        停

        */


        if(
            bankerValue >= 7
        ){

            return false;

        }





        /*
        沒有Player第三張

        代表還沒補牌

        */


        if(
            playerThirdCard === null
        ){

            return false;

        }




        const third =
        this.cardValue(
            playerThirdCard
        );





        /*
        Banker 3

        Player第三張不是8

        */


        if(
            bankerValue === 3
        ){

            return third !== 8;

        }





        /*
        Banker 4

        Player第三張 2-7

        */


        if(
            bankerValue === 4
        ){

            return (
                third >=2 &&
                third <=7
            );

        }







        /*
        Banker 5

        Player第三張 4-7

        */


        if(
            bankerValue === 5
        ){

            return (
                third >=4 &&
                third <=7
            );

        }






        /*
        Banker 6

        Player第三張 6-7

        */


        if(
            bankerValue === 6
        ){

            return (
                third ===6 ||
                third ===7
            );

        }



        return false;


    }







    /*
    判斷勝負

    回傳：

    PLAYER

    BANKER

    TIE


    */


    static winner(
        player,
        banker
    ){


        const p =
        this.handValue(player);


        const b =
        this.handValue(banker);



        if(p>b){

            return "PLAYER";

        }


        if(b>p){

            return "BANKER";

        }


        return "TIE";


    }



}
