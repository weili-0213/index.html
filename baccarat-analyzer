=================================

Baccarat Analyzer

Round Recorder Engine

負責：

- 保存每局
- 扣除牌張
- Undo
- 歷史紀錄

=================================
*/


export default class Recorder {



    constructor(shoe){


        this.shoe = shoe;


        this.history = [];


    }





    /*
    新增牌局

    player:
    ["8","5","3"]

    banker:
    ["9","7","K"]

    */


    addRound(
        player,
        banker
    ){


        const cards = [

            ...player,

            ...banker

        ];



        /*
        確認所有牌存在

        */


        for(
            const card of cards
        ){


            if(
                this.shoe.remaining(card)<=0
            ){

                throw new Error(
                    `牌不足:${card}`
                );

            }


        }





        /*
        扣牌

        */


        cards.forEach(card=>{


            this.shoe.remove(card);


        });





        const round = {


            id:
            this.history.length + 1,


            player:
            [...player],


            banker:
            [...banker],


            cards:
            cards,


            timestamp:
            new Date()

        };





        this.history.push(round);



        return round;


    }







    /*
    Undo上一局

    */


    undo(){


        if(
            this.history.length===0
        ){

            return false;

        }




        const last =
        this.history.pop();




        last.cards.forEach(card=>{


            this.shoe.restore(card);


        });



        return last;


    }







    /*
    取得全部紀錄

    */


    getHistory(){


        return [
            ...this.history
        ];

    }






    /*
    清除紀錄

    */


    clear(){


        this.history=[];


    }






    /*
    最近一局

    */


    last(){


        if(
            this.history.length===0
        ){

            return null;

        }


        return (
            this.history[
                this.history.length-1
            ]
        );


    }




}


