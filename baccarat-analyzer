     * 莊家點數
     */
    get bankerScore() {
        return this.banker.value;
    }

    /**
     * 勝方
     */
    get winner() {

        if (this.playerScore > this.bankerScore) {
            return "Player";
        }

        if (this.bankerScore > this.playerScore) {
            return "Banker";
        }

        return "Tie";
    }

    /**
     * 閒對
     */
    get playerPair() {
        return this.player.isPair;
    }

    /**
     * 莊對
     */
    get bankerPair() {
        return this.banker.isPair;
    }

    /**
     * 閒天牌
     */
    get playerNatural() {
        return this.player.isNatural;
    }

    /**
     * 莊天牌
     */
    get bankerNatural() {
        return this.banker.isNatural;
    }

    /**
     * Super 6
     *
     * 莊贏6點
     */
    get super6() {

        return (
            this.winner === "Banker" &&
            this.bankerScore === 6
        );

    }

