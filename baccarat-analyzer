/**
 * 莊家第三張補牌表
 */

export function bankerThirdCardRule(
    bankerValue,
    playerThirdCard
) {

    if (!playerThirdCard) {
        throw new Error("Player third card required");
    }

    const rank = playerThirdCard.rank;

    if (bankerValue <= 2) {
        return true;
    }

    if (bankerValue === 3) {
        return rank !== "8";
    }

    if (bankerValue === 4) {
        return [
            "2",
            "3",
            "4",
            "5",
            "6",
            "7"
        ].includes(rank);
    }

    if (bankerValue === 5) {
        return [
            "4",
            "5",
            "6",
            "7"
        ].includes(rank);
    }

    if (bankerValue === 6) {
        return [
            "6",
            "7"
        ].includes(rank);
    }

    return false;

}
