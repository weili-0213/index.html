     */
    get isStarted(){

        return this.started;

    }



    /**
     * 進行一局
     */
    play(){


        if(!this.started){

            throw new Error(
                "Game not started"
            );

        }


        const result =
            playRound(
                this.shoe
            );


        this.history.push(
            result
        );


        return result;


    }



    /**
     * 已玩局數
     */
    get rounds(){


        return this.history.length;


    }



    /**
     * 最近一局
     */
    get lastResult(){


        return (
            this.history[
                this.history.length - 1
            ]
            ||
            null
        );

    }



    /**
     * 剩餘牌數
     */
    get remainingCards(){


        return this.shoe.remaining;


    }



    /**
     * 已使用牌
     */
    get usedCards(){


        return this.shoe.used;


    }



    /**
     * 重新開靴
     */
    reset(){


        this.shoe.reset();


        this.burn =
            new Burn(
                this.shoe
            );


        this.history = [];


        this.started = false;


        return this;


    }



    /**
     * JSON
     */
    toJSON(){


        return {

            shoe:
                this.shoe.toJSON(),


            history:
                this.history.map(
                    item => item.toJSON()
                ),


            started:
                this.started

        };


    }


}
