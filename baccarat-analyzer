import BaccaratRules from "./rules.js";



export default class ProbabilityEngine {



    constructor(
        simulations = 100000
    ){


        this.simulations =
            simulations;


    }






    /*
    分析下一局

    shoe:
    目前牌靴

    */


    analyze(shoe){


        let result = {


            PLAYER:0,

            BANKER:0,

            TIE:0,


            PLAYER_PAIR:0,

            BANKER_PAIR:0,


            SUPER6:0


        };





        for(
            let i=0;
            i<this.simulations;
            i++
        ){


            const copy =
            shoe.clone();




            const outcome =
            this.simulateRound(copy);




            result[
                outcome.winner
            ]++;




            if(
                outcome.playerPair
            ){

                result.PLAYER_PAIR++;

            }




            if(
                outcome.bankerPair
            ){

                result.BANKER_PAIR++;

            }




            if(
                outcome.super6
            ){

                result.SUPER6++;

            }


        }





        /*
        轉百分比

        */


        Object.keys(result)
        .forEach(key=>{


            result[key] =
            (
                result[key]
                /
                this.simulations
            )
            *
            100;


        });




        return result;


    }







    /*
    模擬一局

    */


    simulateRound(shoe){



        const player=[];

        const banker=[];




        /*
        發四張

        P B P B

        */


        player.push(
            this.draw(shoe)
        );


        banker.push(
            this.draw(shoe)
        );


        player.push(
            this.draw(shoe)
        );


        banker.push(
            this.draw(shoe)
        );





        /*
        天牌

        */


        if(
            !BaccaratRules
            .isNatural(
                player,
                banker
            )
        ){



            /*
            Player補牌

            */


            if(
                BaccaratRules
                .playerDraw(player)
            ){


                const card =
                this.draw(shoe);


                player.push(card);


            }





            /*
            Banker補牌

            */


            if(
                BaccaratRules
                .bankerDraw(
                    banker,
                    player[2] || null
                )
            ){


                banker.push(
                    this.draw(shoe)
                );


            }


        }





        return {


            winner:

            BaccaratRules
            .winner(
                player,
                banker
            ),



            playerPair:

            player[0]===player[1],



            bankerPair:

            banker[0]===banker[1],




            super6:

            (
                BaccaratRules
                .handValue(banker)
                ===6
                &&
                banker.length===3
            )


        };



    }









    /*
    從牌靴抽牌

    */


    draw(shoe){



        const available=[];



        Object.keys(
            shoe.cards
        )
        .forEach(card=>{


            for(
                let i=0;
                i<
                shoe.remaining(card);
                i++
            ){

                available.push(card);

            }


        });





        const index =
        Math.floor(
            Math.random()
            *
            available.length
        );



        const card =
        available[index];



        shoe.remove(card);



        return card;


    }





}
